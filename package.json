{
  "name": "variable-explorer",
  "displayName": "Variable Explorer",
  "description": "A powerful variable inspection and editing tool for Python development, inspired by Spyder's Variable Explorer",
  "version": "0.3.0",
  "publisher": "VariableExplorer",
  "icon": "logo.png",
  "author": {
    "name": "Marco Liedecke"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcoLiedecke/variable-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/MarcoLiedecke/variable-explorer/issues"
  },
  "homepage": "https://github.com/MarcoLiedecke/variable-explorer#readme",
  "sponsor": {
    "url": "https://buymeacoffee.com/marcoliedecke"
  },
  "keywords": [
    "python",
    "variable explorer",
    "debugger",
    "spyder",
    "data science",
    "pandas",
    "dataframe",
    "inspector"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Data Science"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "variableExplorer.show",
        "title": "Show Variable Explorer",
        "category": "Variable Explorer"
      },
      {
        "command": "variableExplorer.refresh",
        "title": "Refresh Variables",
        "category": "Variable Explorer"
      },
      {
        "command": "variableExplorer.runFile",
        "title": "Run Current Python File",
        "category": "Variable Explorer",
        "icon": "$(play)"
      },
      {
        "command": "variableExplorer.runFileInTerminal",
        "title": "Run Python File (Terminal + Variable Explorer)",
        "category": "Variable Explorer",
        "icon": "$(run-all)"
      },
      {
        "command": "variableExplorer.runSelection",
        "title": "Run Selection/Line",
        "category": "Variable Explorer"
      },
      {
        "command": "variableExplorer.support",
        "title": "Support Variable Explorer",
        "category": "Variable Explorer"
      },
      {
        "command": "variableExplorer.restartBackend",
        "title": "Restart Python Backend",
        "category": "Variable Explorer",
        "icon": "$(debug-restart)"
      },
      {
        "command": "variableExplorer.interrupt",
        "title": "Interrupt Running Code",
        "category": "Variable Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "variableExplorer.showOutput",
        "title": "Show Output",
        "category": "Variable Explorer"
      }
    ],
    "keybindings": [
      {
        "command": "variableExplorer.runFile",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == python && !inDebugMode && config.variableExplorer.useF5Keybinding"
      },
      {
        "command": "variableExplorer.runSelection",
        "key": "f9",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "variableExplorer.runSelection",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == python"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "variableExplorer.runFileInTerminal",
          "when": "resourceLangId == python",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "variableExplorer.runFile",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "variableExplorer.runFileInTerminal",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "variableExplorer.runSelection",
          "when": "resourceLangId == python && editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Variable Explorer",
      "properties": {
        "variableExplorer.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter used by the Variable Explorer. Supports ${workspaceFolder}, ${env:VAR} and ~. Leave empty to use the interpreter selected in the Python extension, then python.defaultInterpreterPath, then a .venv/venv in the workspace, then python3/python on PATH.",
          "scope": "resource"
        },
        "variableExplorer.captureMainLocals": {
          "type": "boolean",
          "default": false,
          "description": "Automatically expose local variables from main() function in the Variable Explorer"
        },
        "variableExplorer.monitorTerminalExecution": {
          "type": "boolean",
          "default": true,
          "description": "Monitor terminal execution to capture variables when using the 'Run Python File' button or running Python in terminal"
        },
        "variableExplorer.extraPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional folders added to sys.path when running code (like PYTHONPATH). Relative paths are resolved against the workspace folder; ${workspaceFolder} is supported. The running file's own folder is always added automatically."
        },
        "variableExplorer.reloadUserModules": {
          "type": "boolean",
          "default": true,
          "description": "Re-import modules from your workspace every time a file is run, so edits to helper modules take effect without restarting (like Spyder's User Module Reloader)."
        },
        "variableExplorer.maxDataFrameRows": {
          "type": "integer",
          "default": 50000,
          "minimum": 100,
          "description": "Maximum number of DataFrame/Series rows loaded into the viewer. CSV export always writes all rows."
        },
        "variableExplorer.showOutputOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Show the 'Variable Explorer' output channel (print output and tracebacks) when running a file or selection with F5/F9."
        },
        "variableExplorer.useF5Keybinding": {
          "type": "boolean",
          "default": true,
          "description": "Use F5 to run the current Python file in the Variable Explorer. Disable to give F5 back to the debugger (F5 never overrides an active debug session)."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "scripts": {
    "test": "npm run test:js && npm run test:python",
    "test:js": "node --test test/js/*.test.js",
    "test:python": "python3 -m unittest discover -s test/python -v",
    "package": "vsce package"
  }
}
